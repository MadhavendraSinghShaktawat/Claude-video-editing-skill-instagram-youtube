 "segments": [
  {
   "start": 0.05,
   "end": 4.23,
   "text": "Managing electric car charging stations shouldn't be rocket science."
  },
  {
   "start": 4.73,
   "end": 7.31,
   "text": "Yet often, that's exactly how it feels."
  },
  {
   "start": 7.91,
   "end": 9.99,
   "text": "It looks complicated and intimidating."
  },
  {
   "start": 10.75,
   "end": 13.65,
   "text": "That's why we built Valens."
  },
  {
   "start": 20.36,
   "end": 26.29,
   "text": "It's a charging management software that's compatible with every business."
  },
  {
   "start": 27.17,
   "end": 31.41,
   "text": "We know many of them don't feel they have the resources to invest in electric mobility."
  },
  {
   "start": 31.91,
   "end": 36.21,
   "text": "Even worse, they fear being stuck with an unreliable product or partner."
  },
  {
   "start": 36.81,
   "end": 39.61,
   "text": "But as the need to use electric cars becomes the norm,"
  },
  {
   "start": 40.62,
   "end": 43.14,
   "text": "the way we recharge them shouldn't be a headache."
  },
  {
   "start": 43.96,
   "end": 47.28,
   "text": "At Valens, we provide straightforward tools and services"
  },
  {
   "start": 47.28,
   "end": 52.92,
   "text": "to make it as easy as possible to buy, use and monetize charging infrastructure,"
  },
  {
   "start": 53.28,
   "end": 57.36,
   "text": "helping thousands of companies feel confident managing charging stations"
  },
  {
   "start": 57.36,
   "end": 60.52,
   "text": "and freeing up time for what they do best."
  },
  {
   "start": 60.52,
   "end": 63.82,
   "text": "We make sure everyone's investment is worthwhile"
  },
  {
   "start": 63.82,
   "end": 67.36,
   "text": "so electric mobility becomes accessible to all."
  },
  {
   "start": 68.61,
   "end": 70.17,
   "text": "This is Valens."
  }
 ]
}