 "segments": [
  {
   "start": 0.62,
   "end": 3.78,
   "text": "When your banking feels like a trip to the 1990s,"
  },
  {
   "start": 4.31,
   "end": 6.59,
   "text": "you know business banking is broken."
  },
  {
   "start": 7.59,
   "end": 9.25,
   "text": "That's why we build AirBank."
  },
  {
   "start": 11.4,
   "end": 13.12,
   "text": "Made for small businesses and startups,"
  },
  {
   "start": 13.82,
   "end": 17.02,
   "text": "AirBank helps you keep track of all your transactions in real time,"
  },
  {
   "start": 17.38,
   "end": 19.38,
   "text": "without asking you to switch banks."
  },
  {
   "start": 20.29,
   "end": 22.43,
   "text": "See all your bank accounts in one place"
  },
  {
   "start": 22.43,
   "end": 25.15,
   "text": "and discover powerful insights into your cash flows."
  },
  {
   "start": 26.16,
   "end": 29.82,
   "text": "Manage your invoices and pay your bills at a fraction of the cost."
  },
  {
   "start": 29.82,
   "end": 33.86,
   "text": "Add your team members and set custom access rights,"
  },
  {
   "start": 34.04,
   "end": 36.66,
   "text": "approval flows and spending limits."
  },
  {
   "start": 37.26,
   "end": 41.4,
   "text": "And with all banking data reconciled with your accounting and revenue sources,"
  },
  {
   "start": 42.34,
   "end": 46.7,
   "text": "you have your net cash flows, runway and key finances in front of you,"
  },
  {
   "start": 47.26,
   "end": 48.14,
   "text": "in real time."
  },
  {
   "start": 48.92,
   "end": 52.9,
   "text": "Stop using disjointed admin software and start enjoying your finances."
  },
  {
   "start": 54.05,
   "end": 56.65,
   "text": "AirBank, cash management for modern businesses."
  },
  {
   "start": 56.65,
   "end": 60.67,
   "text": "Visit joinairbank.com and sign up for free access today."
  }
 ]
}